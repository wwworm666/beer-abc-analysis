# Авторизация
# SECRET_KEY — ключ подписи сессионных cookie. Можно НЕ задавать: тогда он
# генерируется один раз в {/kultura|data}/secret_key и переживает редеплой.
# Если задаёшь явно — НЕ меняй потом без причины (смена разлогинит всех).
SECRET_KEY=
# Первый владелец (admin). Можно оставить пустым и создать через форму на /login
# при первом заходе. Если заданы оба — создаётся на первом старте.
AUTH_BOOTSTRAP_LOGIN=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=
# Secure-флаг cookie. По умолчанию авто: True на проде (есть /kultura), False
# локально по http. Переопределять обычно не нужно.
SESSION_COOKIE_SECURE=

# iiko REST API
IIKO_SERVER=first-federation.iiko.it
IIKO_PORT=443
IIKO_LOGIN=your_login
IIKO_PASSWORD=your_password

# Orderia — внешняя система лояльности (карты, бонусы, привязка к Telegram).
# Нужна разделу «Гости», вкладка «Не купившие»: iiko видит гостя только с первой
# покупкой, поэтому зарегистрировавшихся без единого чека знает только Orderia.
# Без логина/пароля интеграция просто выключена — остальные вкладки работают.
# Разбор API и ловушек данных: docs/technical/ORDERIA_CASHAPI.md
ORDERIA_LOGIN=
ORDERIA_PASSWORD=
# Базовый URL можно не задавать (по умолчанию https://loyalty.orderia.ru/cashapi/)
ORDERIA_BASE_URL=
# Адрес выгрузки карт без покупок. Orderia уже один раз сменила эндпоинт
# (never.php исчез 12.08.2026), поэтому он вынесен в env — новый адрес включается
# правкой .env БЕЗ пересборки образа (docker compose up -d, env читается заново).
#   ORDERIA_NEVER_URL  — весь URL целиком (хост+путь+?query). Переопределяет всё.
#   ORDERIA_NEVER_FILE — только имя файла в каталоге ORDERIA_BASE_URL (по умолч. never.php)
ORDERIA_NEVER_URL=
ORDERIA_NEVER_FILE=

# Telegram — основной бот (аналитика, ABC и т.п.)
TELEGRAM_BOT_TOKEN=

# Telegram — open-check бот (проверка открытых смен в 14:59 МСК)
TELEGRAM_OPEN_CHECK_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_ALARM_CHAT_IDS=

# Удалённый бар-ПК (доступен через Tailscale)
REMOTE_USER=Администратор
REMOTE_HOST=100.98.149.108
REMOTE_PASS=

# Scheduler — ежедневный авторефреш ЧЗ
CHZ_REFRESH_HOUR=3
CHZ_REFRESH_MINUTE=0

# Scheduler — open-check (расписание дефолтное 14:59, не трогать без причины)
OPEN_CHECK_HOUR=14
OPEN_CHECK_MINUTE=59

# Публичный URL приложения (без trailing /)
API_BASE_URL=https://your-domain.example
APP_DOMAIN=your-domain.example

# Cosplay Render: код в routes/open_check.py и routes/misc.py читает
# RENDER_EXTERNAL_URL для авто-base_url при setup-webhook. Дублируем тот же домен.
RENDER_EXTERNAL_URL=https://your-domain.example

# Путь к persistent-данным внутри контейнера (не менять без правок extensions.py)
PERSISTENT_DATA_DIR=/kultura

# Tuya Cloud — термометры по барам (страница /temperature)
# Access ID/Secret берутся из Cloud-проекта на iot.tuya.com (Cloud -> Development).
# Без них опрос температуры и фоновый шедулер не стартуют (фича просто выключена).
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Регион API: EU/РФ — tuyaeu.com, US — tuyaus.com, Китай — tuyacn.com
TUYA_ENDPOINT=https://openapi.tuyaeu.com
# Интервал фонового опроса (минуты). 0 = фоновый опрос выключен (страница всё равно
# делает живой опрос при открытии).
TUYA_POLL_MINUTES=15
# (необязательно) переопределить маппинг устройство->бар без правок кода: JSON
# {"<device_id>": "<venue_key>"}; venue_key из core/venues_config.py
# (bolshoy|ligovskiy|kremenchugskaya|varshavskaya)
TUYA_DEVICE_MAP=
# Тревога по высокой температуре: если в баре выше TUYA_ALARM_TEMP_C — бот открытия
# баров шлёт аларм в TELEGRAM_ALARM_CHAT_IDS (как о закрытых барах). Проверка идёт в
# фоновом опросе (нужен TUYA_POLL_MINUTES > 0). Аларм шлётся ОДИН раз при пересечении
# порога; «вернулось в норму» — когда опустится ниже TUYA_ALARM_CLEAR_C (гистерезис
# против дребезга у границы, по умолчанию порог - 1).
TUYA_ALARM_TEMP_C=26
TUYA_ALARM_CLEAR_C=25
# Тихие часы (МСК): в окне [START, END) тревоги не оцениваются и не шлются (бары
# закрыты/пусты). По умолчанию 01:00–15:00. Поддерживает окно через полночь.
# Сообщение «температура вернулась в норму» не шлётся (только сама тревога о превышении).
TUYA_ALARM_QUIET_START=1
TUYA_ALARM_QUIET_END=15

# ==================== Личный кабинет /me: ночной снимок ====================
# Показатели, KPI и деньги на /me считаются раз в сутки для всех сотрудников
# сразу и лежат JSON-файлом на постоянном томе (см. docs/me.md). Живые данные
# (смены, часы, календарь) снимка не требуют и работают всегда.
ME_SNAPSHOT_ENABLED=1
# ВНИМАНИЕ: время НАИВНОЕ, а в прод-образе нет системного tzdata, поэтому оно
# фактически UTC. 05:40 здесь = 08:40 МСК. Так же работают все остальные
# шедулеры проекта (ЧЗ 03:00 = 06:00 МСК, ЗП 04:00 = 07:00 МСК). Снимок стоит
# последним в цепочке: он потребляет те же кассовые смены и OLAP, что выгрузка ЗП.
ME_SNAPSHOT_HOUR=5
ME_SNAPSHOT_MINUTE=40
# До какого числа месяца ещё пересчитывать ПРЕДЫДУЩИЙ месяц (потом он заморожен,
# но файл остаётся доступен на странице).
ME_SNAPSHOT_PREV_UNTIL_DAY=7
# Кулдаун кнопки «Обновить»: пересчёт общий для всех, чаще одного раза в N минут
# не запускается — прогон ходит в iiko и занимает 1-3 минуты.
ME_REFRESH_COOLDOWN_MIN=30
# Через сколько секунд lock-файл ручного пересчёта считается брошенным и снимается
# (страховка от жёсткого kill: каталог data/ смонтирован на хост и переживает рестарт).
ME_REFRESH_STALE_SEC=1800
# После какого возраста снимка подпись «данные на ...» помечается как устаревшая.
ME_SNAPSHOT_STALE_HOURS=26
