# Почта для ACME. С ней Caddy при отказе Let's Encrypt берёт сертификат у ZeroSSL
# (с v2.8 ZeroSSL без почты не подключается). Для 139-100-200-92.sslip.io это
# единственный путь: sslip.io нет в Public Suffix List, и недельный лимит
# Let's Encrypt на весь sslip.io выбирают другие. Адрес служебный, личной почты
# здесь нет: репозиторий публичный.
{
	email ssl@beerkultura.ru
}

# 139-100-200-92.sslip.io — запасной адрес без своего DNS: sslip.io отвечает IP из имени
# (139.100.200.92). Добавлен 2026-10-27, когда оплата beerkultura.ru истекла и домен
# перестал вести на сервер. Сертификат Caddy выпускает на каждое имя отдельно.
beerkultura.ru, 139-100-200-92.sslip.io {
	encode gzip

	# Кэширование статики на стороне клиента. Ассеты версионируются ?v=<hash>,
	# поэтому длинный max-age безопасен (новая версия = новый URL).
	@static path /static/*
	header @static Cache-Control "public, max-age=2592000"

	reverse_proxy localhost:10000

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format console
	}
}

# 139-100-200-92.nip.io — аварийный адрес с сертификатом собственного центра Caddy
# (tls internal): выдаётся сразу, без Let's Encrypt и ZeroSSL, браузер предупреждает
# о небезопасном подключении. Заодно показывает, что Caddy принял этот Caddyfile:
# свой сертификат он выдаёт только по загруженному конфигу. Убрать, когда заработает
# постоянный домен.
139-100-200-92.nip.io {
	tls internal
	encode gzip
	reverse_proxy localhost:10000
}

# www → apex редирект (Caddy сам выпустит второй LE-сертификат)
www.beerkultura.ru {
	redir https://beerkultura.ru{uri} permanent
}
