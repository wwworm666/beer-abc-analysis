      "tolerance": {"abs": 0},
      "unit": "руб."
    },
    {
      "id": "staff-cleanliness-not-marked",
      "domain": "staff",
      "question": "Сколько открывающих смен за {prev_month} осталось без отметки «Как принял бар?»?",
      "expect_tools": ["staff_cleanliness_month"],
      "reference": {"tool": "staff_cleanliness_month", "args": {"year": "{prev_month_year}", "month": "{prev_month_num}"}, "path": "totals.not_marked"},
      "tolerance": {"abs": 0},
      "unit": "смен"
    },
    {
      "id": "staff-admin-accounts",
      "domain": "staff",
      "question": "Сколько аккаунтов сайта с правами администратора?",
      "expect_tools": ["staff_auth_users"],
      "reference": {"tool": "staff_auth_users", "args": {}, "path": "|count:is_admin=true"},
