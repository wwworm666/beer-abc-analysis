# Локальные секреты и служебные заметки (пароли, токены): только на машине владельца,
# в репозиторий и образ не попадают (.dockerignore исключает secrets/ тоже).
secrets/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
nul

# Данные кранов (хранятся на Render Disk, не в git)
data/taps_data.json
# Заказы поставщикам (общий черновик и история; на проде живут на /kultura)
data/orders.json
data/suppliers.json
# Отзывы гостей (раздел «Гости»; на проде живут на /kultura)
data/guest_reviews.json
# Контент-план раздела «Гости» и его фото/видео (на проде живут на /kultura)
data/content_plan.json
data/content_media/
# Комментарии к периодам дашборда (core/plans_manager.PeriodCommentsStore; на проде — /kultura)
data/period_comments.json*
# Настройки «Каналы и отправка» контент-плана (core/content_channels.py; на проде — /kultura)
data/content_channels.json*
# Бриф сети для ИИ-агента (core/content_brief.py) и SQLite MCP-платформы
# (токены, OAuth, журнал вызовов — core/mcp/db.py); на проде живут на /kultura
data/content_brief.json
data/mcp.db
data/mcp.db-*
# Фиды Яндекса: правки позиций и снимок пива (на проде живут на /kultura)
data/yml_*.json
data/yml_*.json.*
taps_data*.json

# Бэкапы
*.bak
*.backup
data/*.backup

# Логи
*.log
data/*.log
# Имя без расширения — gunicorn/прочие writers любят писать в "logs"
/logs
/logs/

# Временные файлы
*.tmp
*.temp
data/temp/

# Advisory lock-файлы (portalocker: plans, daily_plans, day_weight_overrides)
*.lock
data/*.lock

# Кэши
data/cache/

# Месячный отчёт: генерируемая витрина + lock-файлы шедулера
# (на проде живут на /kultura и /srv/beer/data, в репо не нужны)
data/monthly_cache/
data/.monthly_report_lock_*
data/.monthly_report_startup_*

# Аналитика гостей: lock-файлы шедулера синка (витрина data/guests.db покрыта data/*.db)
data/.guests_sync_lock_*
data/.guests_sync_startup_*

# API ключи и секреты
апи
.env
# Копии .env рядом с ним (.env.bak-iiko и т. п.): на сервере неотслеживаемый файл в
# /opt/beer останавливает выкладку («Server checkout has local changes», 2026-09-29).
.env.bak*
.env.*.bak
api_key.txt
*.key

# Временные тестовые файлы
loyalty_raw.json
loyalty_test.json

# Локальные дампы explorer/draft/kitchen — фикстуры для разработки
/explorer_test.json
/test_bottled_*.json
/test_draft_*.json
/test_kitchen_*.json

# Локальные отчеты и экспорты
data/reports/
tests/exports/

# Артефакты анализов
data/*.csv
data/*.db
data/*.db.backup_v*

# Секрет подписи сессий — генерируется локально/на проде, в репо не должен попадать
data/secret_key
secret_key

# Архив скриптов
archive/
