# 20. Базовый рабочий пример

Ориентируйся на этот паттерн, но адаптируй его к текущей архитектуре проекта:

```python
from ya_business_api.async_api import AsyncAPI
from ya_business_api.reviews.dataclasses.requests import ReviewsRequest
from ya_business_api.reviews.constants import Ranking


async def fetch_company_reviews(api, permanent_id):
    request = ReviewsRequest(
        permanent_id=permanent_id,
        ranking=Ranking.BY_TIME,
    )

    while True:
        response = await api.reviews.get_reviews(request)

        for review in response.list.items:
            yield review

        token = response.list.pager.continue_token

        if not token:
            break

        request = ReviewsRequest(
            permanent_id=permanent_id,
            ranking=Ranking.BY_TIME,
            continue_token=token,
        )


async def sync_yandex_reviews():
    api = await AsyncAPI.build(
        session_id=settings.YANDEX_BUSINESS_SESSION_ID,
        session_id2=settings.YANDEX_BUSINESS_SESSION_ID2,
    )

    try:
        async for company in get_all_yandex_branches(api):

            async for review in fetch_company_reviews(
                api,
                company.permanent_id,
            ):
                await upsert_yandex_review(
                    company=company,
                    review=review,
                )

    finally:
        await api.session.close()
```

Сначала сделай минимальный diagnostic script, который просто авторизуется, выводит найденные филиалы и последние отзывы. Когда это подтверждено реальными данными — подключай к существующим моделям, scheduler и странице.

Не переписывай готовую страницу и существующую архитектуру без необходимости. Задача — добавить источник данных Яндекс и встроить его в уже существующий reviews flow.